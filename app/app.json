{
  "expo": {
    "name": "LightScrapVidz",
    "slug": "light-scrap-vidz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lightscrapvidz",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.ouestcast.lightscrapvidz",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Save downloaded videos to your photo library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "fr.ouestcast.lightscrapvidz",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-media-library",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9F25E"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#141310",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "defaultServerUrl": "https://light-scrap-vidz.fly.dev"
    }
  }
}
